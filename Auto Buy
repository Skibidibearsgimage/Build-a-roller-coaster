	end,
})



local DecorationShopToggles = {}
local RepeatBuyLoops = {}

local function startRepeatBuy(itemName)
	if RepeatBuyLoops[itemName] then
		return
	end

	RepeatBuyLoops[itemName] = true

	task.spawn(function()
		while DecorationShopToggles[itemName] == true do
			local success, result = pcall(function()
				return DecorationShop:InvokeServer("buy", "Decorations", itemName)
			end)

			if success then
				print("[SRBX] Bought:", itemName, result)
			else
				warn("[SRBX] Buy failed:", itemName, result)
			end

			task.wait(0.25) -- change this to 0.1, 0.25, 0.5 depending on how fast you want it
		end

		RepeatBuyLoops[itemName] = nil
	end)
end

local sortedDecorations = {}
for name, info in pairs(DecorationItems) do
	table.insert(sortedDecorations, {
		name = name,
		price = info.price,
	})
end

table.sort(sortedDecorations, function(a, b)
	return a.price < b.price
end)

for _, item in ipairs(sortedDecorations) do
	DecorationTab:CreateToggle({
		Name = string.format("%s  %s", item.name, item.price),
		CurrentValue = false,
		Callback = function(enabled)
			DecorationShopToggles[item.name] = enabled

			if enabled then
				startRepeatBuy(item.name)
			end
		end,
	})
end
